<UserControl x:Class="SafeGuardXUltimate.Views.ExtraFeaturesView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>

        <Border Style="{StaticResource CardStyle}" Margin="0,0,12,0">
            <StackPanel>
                <TextBlock Text="Gamification and utility features" Style="{StaticResource HeadingTextStyle}" />
                <WrapPanel Margin="0,8,0,8">
                    <CheckBox Content="Game Mode" IsChecked="{Binding GameModeEnabled}" Margin="0,0,16,0"/>
                    <CheckBox Content="Silent Mode" IsChecked="{Binding SilentModeEnabled}" Margin="0,0,16,0"/>
                    <CheckBox Content="Fake VPN" IsChecked="{Binding VpnEnabled}"/>
                </WrapPanel>

                <TextBlock Text="Battle Pass level" />
                <Slider Minimum="1" Maximum="60" Value="{Binding BattlePassLevel}" />
                <TextBlock Text="{Binding BattlePassLevel, StringFormat=Current tier: {0}}" Foreground="{StaticResource AccentBlue}" />

                <ItemsControl ItemsSource="{Binding Features}" Margin="0,10,0,0">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <TextBlock Text="•  {Binding}" Margin="0,6" />
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>

                <TextBlock Text="Achievements" Style="{StaticResource SubHeadingTextStyle}" Margin="0,20,0,8" />
                <ItemsControl ItemsSource="{Binding Achievements}">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <TextBlock Text="{Binding Title}" Foreground="{StaticResource AccentBlue}" Margin="0,4" />
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </StackPanel>
        </Border>

        <Border Grid.Column="1" Style="{StaticResource CardStyle}">
            <StackPanel>
                <TextBlock Text="Security News / Threat Map Feed" Style="{StaticResource SubHeadingTextStyle}" />
                <ItemsControl ItemsSource="{Binding News}">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <Border Margin="0,6" Background="#111C2532" Padding="8" CornerRadius="8">
                                <StackPanel>
                                    <TextBlock Text="{Binding Headline}" TextWrapping="Wrap" />
                                    <TextBlock Text="{Binding Category}" Foreground="{StaticResource TextSecondary}" FontSize="12" />
                                </StackPanel>
                            </Border>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </StackPanel>
        </Border>
    </Grid>
</UserControl>
