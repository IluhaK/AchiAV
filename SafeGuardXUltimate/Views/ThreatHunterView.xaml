<UserControl x:Class="SafeGuardXUltimate.Views.ThreatHunterView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="2*"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>

        <Border Style="{StaticResource CardStyle}" Margin="0,0,12,0">
            <StackPanel>
                <TextBlock Text="Threat Clicker (Security Productivity Module)" Style="{StaticResource HeadingTextStyle}" />
                <TextBlock Text="Tokens: {Binding Tokens}" Margin="0,8,0,0" FontSize="20" FontWeight="SemiBold"/>
                <TextBlock Text="Status: {Binding Status}" Foreground="{DynamicResource TextSecondary}" Margin="0,0,0,8"/>

                <Button Content="Neutralize threat event" Command="{Binding ClickThreatCommand}" Style="{StaticResource ActionButtonStyle}" Width="240" Margin="0,0,0,12"/>

                <Grid Margin="0,0,0,8">
                    <Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="Auto"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                    <TextBlock Text="Click Power" VerticalAlignment="Center"/>
                    <TextBlock Grid.Column="1" Text="{Binding ClickPower}" Margin="8,0" VerticalAlignment="Center"/>
                    <Button Grid.Column="2" Content="Upgrade" Command="{Binding UpgradeClickCommand}" Style="{StaticResource ActionButtonStyle}" Width="90"/>
                </Grid>

                <Grid Margin="0,0,0,8">
                    <Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="Auto"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                    <TextBlock Text="Auto Mining (/s)" VerticalAlignment="Center"/>
                    <TextBlock Grid.Column="1" Text="{Binding AutoTokensPerTick}" Margin="8,0" VerticalAlignment="Center"/>
                    <Button Grid.Column="2" Content="Upgrade" Command="{Binding UpgradeAutoCommand}" Style="{StaticResource ActionButtonStyle}" Width="90"/>
                </Grid>

                <Grid>
                    <Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="Auto"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                    <TextBlock Text="Multiplier" VerticalAlignment="Center"/>
                    <TextBlock Grid.Column="1" Text="{Binding Multiplier, StringFormat=x{0}}" Margin="8,0" VerticalAlignment="Center"/>
                    <Button Grid.Column="2" Content="Upgrade" Command="{Binding UpgradeMultiplierCommand}" Style="{StaticResource ActionButtonStyle}" Width="90"/>
                </Grid>
            </StackPanel>
        </Border>

        <Border Grid.Column="1" Style="{StaticResource CardStyle}">
            <StackPanel>
                <TextBlock Text="Token Store" Style="{StaticResource SubHeadingTextStyle}" />
                <ComboBox ItemsSource="{Binding ShopItems}" SelectedItem="{Binding SelectedShopItem}" DisplayMemberPath="Name" Margin="0,8,0,8"/>
                <Button Content="Buy Selected" Command="{Binding BuyShopItemCommand}" Style="{StaticResource ActionButtonStyle}"/>

                <TextBlock Text="Unlocked cosmetics" Style="{StaticResource SubHeadingTextStyle}" Margin="0,14,0,4"/>
                <ItemsControl ItemsSource="{Binding OwnedCosmetics}">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate><TextBlock Text="•  {Binding}" Margin="0,3" TextWrapping="Wrap"/></DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </StackPanel>
        </Border>
    </Grid>
</UserControl>
