<UserControl x:Class="SafeGuardXUltimate.Views.ThreatHunterView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="2*"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>

        <Border Style="{StaticResource CardStyle}" Margin="0,0,12,0">
            <StackPanel>
                <TextBlock Text="Threat Clicker (Integrated Product Module)" Style="{StaticResource HeadingTextStyle}" />
                <TextBlock Text="Tokens: {Binding Tokens}" Margin="0,8,0,0" />
                <TextBlock Text="Neutralized: {Binding ThreatsNeutralized}" />
                <TextBlock Text="Rank: {Binding Rank}" Foreground="{DynamicResource AccentSecondary}" FontWeight="Bold" />
                <TextBlock Text="Prestige: {Binding PrestigeLevel}" Foreground="{DynamicResource AccentPrimary}" FontWeight="Bold" />
                <TextBlock Text="Boss Level: {Binding BossLevel}" />

                <WrapPanel Margin="0,16,0,0">
                    <Button Content="Neutralize threat" Command="{Binding HuntCommand}" Style="{StaticResource ActionButtonStyle}" Width="170" Margin="0,0,10,10"/>
                    <Button Content="Fight Boss" Command="{Binding FightBossCommand}" Style="{StaticResource ActionButtonStyle}" Width="130" Margin="0,0,10,10"/>
                    <Button Content="Daily reward" Command="{Binding ClaimDailyRewardCommand}" Style="{StaticResource ActionButtonStyle}" Width="150" Margin="0,0,10,10"/>
                    <Button Content="Prestige" Command="{Binding PrestigeCommand}" Style="{StaticResource ActionButtonStyle}" Width="110" Margin="0,0,10,10"/>
                </WrapPanel>

                <TextBlock Text="Upgrades" Style="{StaticResource SubHeadingTextStyle}" Margin="0,8,0,8" />
                <WrapPanel>
                    <Button Content="Scan Drone" Command="{Binding BuyDroneCommand}" Style="{StaticResource ActionButtonStyle}" Width="130" Margin="0,0,10,10"/>
                    <Button Content="AI Defender" Command="{Binding BuyAiCommand}" Style="{StaticResource ActionButtonStyle}" Width="130" Margin="0,0,10,10"/>
                    <Button Content="Quantum Shield" Command="{Binding BuyQuantumCommand}" Style="{StaticResource ActionButtonStyle}" Width="140" Margin="0,0,10,10"/>
                </WrapPanel>

                <ItemsControl ItemsSource="{Binding Upgrades}">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <Border BorderBrush="#3345D0FF" BorderThickness="1" CornerRadius="6" Margin="0,6" Padding="8">
                                <StackPanel>
                                    <TextBlock Text="{Binding Name}" FontWeight="SemiBold"/>
                                    <TextBlock Text="{Binding Description}" Foreground="{DynamicResource TextSecondary}"/>
                                    <TextBlock Text="Level: {Binding Level}" Foreground="{DynamicResource AccentPrimary}"/>
                                </StackPanel>
                            </Border>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </StackPanel>
        </Border>

        <Border Grid.Column="1" Style="{StaticResource CardStyle}">
            <StackPanel>
                <TextBlock Text="Token Store" Style="{StaticResource SubHeadingTextStyle}" />
                <ComboBox ItemsSource="{Binding ShopItems}" SelectedItem="{Binding SelectedShopItem}" DisplayMemberPath="Name" Margin="0,8,0,8"/>
                <Button Content="Buy Selected Cosmetic" Command="{Binding BuyShopItemCommand}" Style="{StaticResource ActionButtonStyle}"/>

                <TextBlock Text="Owned" Style="{StaticResource SubHeadingTextStyle}" Margin="0,14,0,4"/>
                <ItemsControl ItemsSource="{Binding OwnedCosmetics}">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate><TextBlock Text="•  {Binding}" Margin="0,3" TextWrapping="Wrap"/></DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </StackPanel>
        </Border>
    </Grid>
</UserControl>
