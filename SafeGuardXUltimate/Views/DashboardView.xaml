<UserControl x:Class="SafeGuardXUltimate.Views.DashboardView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:controls="clr-namespace:SafeGuardXUltimate.Controls">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <DockPanel>
            <StackPanel Orientation="Horizontal" DockPanel.Dock="Left">
                <TextBlock Text="Protection Status: " Style="{StaticResource HeadingTextStyle}" />
                <TextBlock Text="SECURED" Foreground="{DynamicResource AccentPrimary}" FontSize="24" FontWeight="Bold" />
                <TextBlock Text="   Security Score:" Margin="20,0,0,0" Style="{StaticResource HeadingTextStyle}" />
                <TextBlock Text="{Binding SecurityScore}" Foreground="{DynamicResource AccentSecondary}" FontSize="24" FontWeight="Bold" />
            </StackPanel>
            <TextBlock DockPanel.Dock="Right" Text="{Binding ScanStatus}" VerticalAlignment="Center" Foreground="{DynamicResource TextSecondary}" />
        </DockPanel>

        <Grid Grid.Row="1" Margin="0,16,0,16">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="3*" />
                <ColumnDefinition Width="2*" />
            </Grid.ColumnDefinitions>

            <StackPanel Orientation="Horizontal">
                <Button Content="Quick Scan" Command="{Binding QuickScanCommand}" Style="{StaticResource ActionButtonStyle}" />
                <Button Content="Full Scan" Command="{Binding FullScanCommand}" Style="{StaticResource ActionButtonStyle}" />
                <Button Content="Deep Scan" Command="{Binding DeepScanCommand}" Style="{StaticResource ActionButtonStyle}" />
                <Button Content="Vulnerability Scan" Command="{Binding RunVulnerabilityScanCommand}" Style="{StaticResource ActionButtonStyle}" />
                <Button Content="Update Center" Command="{Binding UpdateDefinitionsCommand}" Style="{StaticResource ActionButtonStyle}" />
                <controls:AnimatedRingControl Width="90" Height="90" Progress="{Binding Progress}" Margin="20,0,0,0" />
            </StackPanel>

            <StackPanel Grid.Column="1" Orientation="Horizontal" HorizontalAlignment="Right">
                <Border Style="{StaticResource CardStyle}" Margin="4,0" Width="100"><StackPanel><TextBlock Text="Files"/><TextBlock Text="{Binding FilesScanned}"/></StackPanel></Border>
                <Border Style="{StaticResource CardStyle}" Margin="4,0" Width="100"><StackPanel><TextBlock Text="Processes"/><TextBlock Text="{Binding ProcessesScanned}"/></StackPanel></Border>
                <Border Style="{StaticResource CardStyle}" Margin="4,0" Width="100"><StackPanel><TextBlock Text="Detected"/><TextBlock Text="{Binding ThreatsDetected}"/></StackPanel></Border>
                <Border Style="{StaticResource CardStyle}" Margin="4,0" Width="100"><StackPanel><TextBlock Text="Quarantine"/><TextBlock Text="{Binding Quarantine.Count}"/></StackPanel></Border>
            </StackPanel>
        </Grid>

        <Grid Grid.Row="2">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="3*" />
                <ColumnDefinition Width="2*" />
            </Grid.ColumnDefinitions>

            <TabControl Margin="0,0,12,0">
                <TabItem Header="Scan Console">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="*"/>
                        </Grid.RowDefinitions>
                        <TextBlock Text="{Binding CurrentTarget}" Foreground="{DynamicResource TextSecondary}" Margin="0,0,0,8" />
                        <ListBox Grid.Row="1" ItemsSource="{Binding ScanLog}">
                            <ListBox.ItemTemplate>
                                <DataTemplate><TextBlock Text="{Binding Message}"/></DataTemplate>
                            </ListBox.ItemTemplate>
                        </ListBox>
                    </Grid>
                </TabItem>

                <TabItem Header="Protection Modules">
                    <StackPanel Margin="8">
                        <Grid Margin="0,0,0,10"><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="80"/></Grid.ColumnDefinitions><TextBlock Text="Real-Time Protection"/><CheckBox Grid.Column="1" IsChecked="{Binding RealTimeProtectionEnabled}" Style="{StaticResource ToggleSwitchStyle}"/></Grid>
                        <Grid Margin="0,0,0,10"><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="80"/></Grid.ColumnDefinitions><TextBlock Text="Firewall Monitor"/><CheckBox Grid.Column="1" IsChecked="{Binding FirewallMonitorEnabled}" Style="{StaticResource ToggleSwitchStyle}"/></Grid>
                        <Grid Margin="0,0,0,10"><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="80"/></Grid.ColumnDefinitions><TextBlock Text="Web Protection"/><CheckBox Grid.Column="1" IsChecked="{Binding WebProtectionEnabled}" Style="{StaticResource ToggleSwitchStyle}"/></Grid>
                        <Grid Margin="0,0,0,10"><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="80"/></Grid.ColumnDefinitions><TextBlock Text="Privacy Protection"/><CheckBox Grid.Column="1" IsChecked="{Binding PrivacyProtectionEnabled}" Style="{StaticResource ToggleSwitchStyle}"/></Grid>
                        <Grid Margin="0,0,0,10"><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="80"/></Grid.ColumnDefinitions><TextBlock Text="Update Center"/><CheckBox Grid.Column="1" IsChecked="{Binding UpdateCenterEnabled}" Style="{StaticResource ToggleSwitchStyle}"/></Grid>

                        <TextBlock Text="Update channel" Margin="0,8,0,4" />
                        <ComboBox ItemsSource="{Binding UpdateChannels}" SelectedItem="{Binding UpdateChannel}"/>
                        <TextBlock Text="{Binding LastUpdateStatus}" Foreground="{DynamicResource TextSecondary}" Margin="0,8,0,0" TextWrapping="Wrap"/>
                    </StackPanel>
                </TabItem>

                <TabItem Header="Reports &amp; Vulnerabilities">
                    <StackPanel Margin="8">
                        <TextBlock Text="Detailed Scan Report" Style="{StaticResource SubHeadingTextStyle}"/>
                        <TextBlock Text="{Binding LastScanReport}" TextWrapping="Wrap" Foreground="{DynamicResource TextSecondary}" Margin="0,4,0,12"/>
                        <TextBlock Text="Vulnerability Findings" Style="{StaticResource SubHeadingTextStyle}" />
                        <ItemsControl ItemsSource="{Binding VulnerabilityFindings}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate><TextBlock Text="•  {Binding}" Margin="0,4" TextWrapping="Wrap"/></DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </StackPanel>
                </TabItem>
            </TabControl>

            <StackPanel Grid.Column="1">
                <Border Style="{StaticResource CardStyle}" Margin="0,0,0,12">
                    <StackPanel>
                        <TextBlock Text="Threat Events / Quarantine" Style="{StaticResource SubHeadingTextStyle}" />
                        <ItemsControl ItemsSource="{Binding Quarantine}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Border Background="#22FF4D4D" Margin="0,4" Padding="8" CornerRadius="8">
                                        <StackPanel>
                                            <TextBlock Text="{Binding Name}" />
                                            <TextBlock Text="{Binding Path}" FontSize="11" Foreground="{DynamicResource TextSecondary}"/>
                                        </StackPanel>
                                    </Border>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </StackPanel>
                </Border>

                <Border Style="{StaticResource CardStyle}" Margin="0,0,0,12">
                    <StackPanel>
                        <TextBlock Text="Activity / Firewall / Web Notifications" Style="{StaticResource SubHeadingTextStyle}" />
                        <ItemsControl ItemsSource="{Binding Notifications}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate><TextBlock Text="{Binding}" Margin="0,3" TextWrapping="Wrap" /></DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                        <ProgressBar Value="{Binding SecurityScore}" Maximum="100" Margin="0,12,0,0"/>
                    </StackPanel>
                </Border>

                <Border Style="{StaticResource CardStyle}">
                    <Grid Visibility="{Binding CriticalEffectsEnabled, Converter={StaticResource BoolToVisibilityConverter}}">
                        <Rectangle Fill="#55FF2A2A" RadiusX="12" RadiusY="12" />
                        <TextBlock Text="CRITICAL THREAT MODE ACTIVE" HorizontalAlignment="Center" VerticalAlignment="Center" FontSize="20" FontWeight="Bold" Foreground="White" TextAlignment="Center" />
                    </Grid>
                </Border>
            </StackPanel>
        </Grid>
    </Grid>
</UserControl>
